# ============================================================================
# Feishu Agent for Cursor - Environment Configuration
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
# ============================================================================

# [Required] Your personal Feishu user open_id (e.g., ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
# Only messages from this user will be accepted, and proactive notifications will be pushed here.
# Tip: Leave it empty on first run and send a message to the bot to see your open_id in the console log.
FEISHU_OPEN_ID=ou_your_feishu_open_id_here

# [Optional] Conversation ID (UUID) of the Master Agent in Cursor Agents window.
# Normal messages without a quote-reply or @N prefix are routed to this Master Agent.
# If left empty, defaults to session #1 discovered in Cursor.
MASTER_CHAT_ID=

# [Optional] Path to the `lark-cli` executable (defaults to searching `lark-cli` in PATH or ~/.local/bin/lark-cli)
LARK_CLI=lark-cli

# [Optional] Chrome DevTools Protocol endpoint exposed by Cursor (default: http://127.0.0.1:9222)
CDP_URL=http://127.0.0.1:9222
